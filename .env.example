DATABASE_URL="file:../data/anima.sqlite"

# RunPod Endpoint/API key và LLM API key nhập trong trang Cài đặt (lưu SQLite cục bộ).
# RUNPOD_OUTPUT_PREFIX=runpod-out # tùy chọn, phải khớp env của worker (mặc định: runpod-out)

# --- Auto-censor (fallback local CPU) ---
# Worker RunPod tự động che ảnh vùng nhạy cảm.
# CENSOR_PYTHON chỉ dùng làm fallback cục bộ khi cần chạy NudeNet trên CPU.
CENSOR_PYTHON=

# Cấu hình tùy chọn cho censor:
#   CENSOR_THRESHOLD=0.25
#   CENSOR_PADDING=0.35
#   CENSOR_BLUR_RADIUS=45
#   CENSOR_FEATHER=8
#   CENSOR_MODEL_PATH=
#   CENSOR_INFERENCE_RESOLUTION=320

# --- Cloudflare R2 Export ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=calendars/anima

# --- Google Sheets Auto Sync ---
# Dùng một trong hai: chuỗi JSON (ưu tiên) hoặc đường dẫn file service account
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
