DATABASE_URL="file:../data/anima.sqlite"

# Optional bearer/API token for a future authenticated ComfyUI gateway.
# Never exposed to the client; only read server-side.
COMFY_GATEWAY_TOKEN=

# API key for the "Trợ lý AI" (LLM-assisted) creation mode. Works with any
# OpenAI-compatible Chat Completions endpoint (OpenAI, OpenRouter, Groq, or a
# local server like Ollama/LM Studio -- use a placeholder value for those).
# Never exposed to the client; only read server-side.
LLM_API_KEY=

# --- Auto-censor (blur sensitive regions) ---
# No env var needed for the normal path: the censor service runs on the SAME
# Colab GPU machine as ComfyUI, reached through the SAME tunnel URL you already
# paste into Settings (comfyBaseUrl) -- the app calls `${that URL}/censor`
# automatically. Run Cell 7.5 + Cell 8 in the notebook to start it. If it isn't
# running yet, images just get no masked copy (maskStatus "skipped") -- no
# error, no extra config.

# Fallback only: path to a Python 3.11 interpreter with the auto-censor deps
# installed (see scripts/censor/README.md). Runs NudeNet locally on CPU. Used
# only when no ComfyUI tunnel is configured (local dev / offline).
CENSOR_PYTHON=

# Optional tuning (honoured by both backends). Defaults shown; leave empty to
# use them. Balanced mode blurs only EXPOSED regions.
#   CENSOR_THRESHOLD=0.25          # min detection score (NudeNet floors at 0.25)
#   CENSOR_PADDING=0.35            # extra margin around each region (fraction)
#   CENSOR_BLUR_RADIUS=45          # Gaussian blur strength
#   CENSOR_FEATHER=8               # soft-mask edge feather
# Local sidecar only -- the cloud service picks its own model:
#   CENSOR_MODEL_PATH=            # path to 640m.onnx for better recall
#   CENSOR_INFERENCE_RESOLUTION=320  # set 640 when using 640m.onnx
