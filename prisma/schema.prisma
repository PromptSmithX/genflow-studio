generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GlobalPrompt {
  id             String   @id @default("main")
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  updatedAt      DateTime @updatedAt
}

model StylePreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs GenerationJob[]

  @@index([isActive])
  @@index([sortOrder])
}

model ScenePreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs GenerationJob[]

  @@index([isActive])
  @@index([sortOrder])
}

model PosePreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs GenerationJob[]

  @@index([isActive])
  @@index([sortOrder])
}

model MediumPreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model AppSettings {
  id                String   @id @default("main")
  comfyBaseUrl      String?
  hasGatewayToken   Boolean  @default(false)
  defaultWidth      Int      @default(1024)
  defaultHeight     Int      @default(1024)
  defaultSteps      Int      @default(25)
  defaultCfg        Float    @default(4.0)
  defaultSeedMode   String   @default("random") // "random" | "fixed"
  defaultFixedSeed  BigInt?
  maxImagesPerBatch Int      @default(20)
  outputDirectory   String   @default("data/outputs")
  llmBaseUrl        String?
  llmModel          String?
  llmSystemPrompt   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WorkflowConfig {
  id                   String    @id @default("main")
  workflowRelativePath String
  originalFilename     String
  nodeCount            Int       @default(0)
  nodeMappingJson      String    @default("{}")
  isValidated          Boolean   @default(false)
  validatedAt          DateTime?
  importedAt           DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum BatchStatus {
  queued
  running
  completed
  partial
  failed
}

enum JobStatus {
  queued
  running
  completed
  failed
  unknown
}

model GenerationBatch {
  id             String      @id @default(cuid())
  ideaPrompt     String
  status         BatchStatus @default(queued)
  requestedCount Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  jobs GenerationJob[]

  @@index([createdAt])
  @@index([status])
}

model GenerationJob {
  id                    String    @id @default(cuid())
  batchId               String
  indexInBatch          Int
  styleId               String?
  styleNameSnapshot     String?
  stylePositiveSnapshot String?
  styleNegativeSnapshot String?
  sceneId               String?
  sceneNameSnapshot     String?
  scenePositiveSnapshot String?
  sceneNegativeSnapshot String?
  poseId                String?
  poseNameSnapshot      String?
  posePositiveSnapshot  String?
  poseNegativeSnapshot  String?
  ideaPromptSnapshot    String
  positiveFinal         String
  negativeFinal         String
  promptId              String?
  status                JobStatus @default(queued)
  seed                  BigInt?
  width                 Int?
  height                Int?
  steps                 Int?
  cfg                   Float?
  sampler               String?
  scheduler             String?
  errorCode             String?
  errorMessage          String?
  submittedAt           DateTime?
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  batch  GenerationBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  style  StylePreset?     @relation(fields: [styleId], references: [id], onDelete: SetNull)
  scene  ScenePreset?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  pose   PosePreset?      @relation(fields: [poseId], references: [id], onDelete: SetNull)
  images GeneratedImage[]

  @@index([batchId])
  @@index([status])
  @@index([styleId])
  @@index([sceneId])
  @@index([poseId])
  @@index([promptId])
}

model GeneratedImage {
  id           String   @id @default(cuid())
  jobId        String
  relativePath String
  filename     String
  mimeType     String
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
}
