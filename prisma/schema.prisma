generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GlobalPrompt {
  id             String   @id @default("main")
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  updatedAt      DateTime @updatedAt
}

model StylePreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs GenerationJob[]

  @@index([isActive])
  @@index([sortOrder])
}

model ScenePreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs GenerationJob[]

  @@index([isActive])
  @@index([sortOrder])
}

model PosePreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs GenerationJob[]

  @@index([isActive])
  @@index([sortOrder])
}

model MediumPreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  positivePrompt String   @default("")
  negativePrompt String   @default("")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model AppSettings {
  id                String   @id @default("main")
  comfyBaseUrl      String?
  hasGatewayToken   Boolean  @default(false)
  defaultWidth      Int      @default(1024)
  defaultHeight     Int      @default(1024)
  defaultSteps      Int      @default(25)
  defaultCfg        Float    @default(4.0)
  defaultSeedMode   String   @default("random") // "random" | "fixed"
  defaultFixedSeed  BigInt?
  maxImagesPerBatch Int      @default(15)
  // Mặc định tương đối nằm NGOÀI project root (data/ là anh em của thư mục app,
  // không phải con) để tránh Next.js dev watch thư mục này -- ảnh/DB được ghi
  // liên tục trong đó sẽ trigger full-page reload nếu nằm trong vùng watch.
  outputDirectory   String   @default("outputs")
  llmBaseUrl        String?
  llmModel          String?
  llmSystemPrompt   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WorkflowConfig {
  id                   String    @id @default("main")
  workflowRelativePath String
  originalFilename     String
  nodeCount            Int       @default(0)
  nodeMappingJson      String    @default("{}")
  isValidated          Boolean   @default(false)
  validatedAt          DateTime?
  importedAt           DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum BatchStatus {
  queued
  running
  completed
  partial
  failed
}

enum JobStatus {
  queued
  running
  completed
  failed
  unknown
}

model GenerationBatch {
  id             String      @id @default(cuid())
  ideaPrompt     String
  status         BatchStatus @default(queued)
  requestedCount Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Bìa sau ghép từ 12 artwork (indexInBatch 1-12) của chính batch này, tạo
  // tự động cuối lib/generations/upscale-image.ts::upscaleBatch. null = chưa
  // tạo (batch cũ trước khi có tính năng này, hoặc batch chưa upscale lần nào).
  backCoverRelativePath String?
  // "done" | "failed" | null.
  backCoverStatus       String?
  // id khổ template lịch đã ghép theo, vd "premade_wall_11x8_5".
  backCoverFormat       String?
  backCoverWidth        Int?
  backCoverHeight       Int?

  // Bản export gọn (2 thư mục khong-che/da-che) tạo cuối upscaleBatch, xem
  // lib/generations/upscale-image.ts::exportBatchFolders. null = chưa xuất.
  // "done" | "failed" | null.
  finalExportStatus         String?
  // Slug thư mục con dưới finalRoot (từ buildBatchFolder), vd
  // "2026-11-02_22-29_..._sf4u7b". null nếu chưa xuất hoặc xuất thất bại.
  finalExportRelativePath   String?

  // Trạng thái tạo mockup sản phẩm (5 ảnh phối cảnh trong thư mục mockup/ dưới finalRoot).
  // "done" | "failed" | null.
  mockupStatus              String?

  // Medium (Người thực/Anime...) đã chọn khi tạo batch qua Trợ lý AI -- quyết
  // định system prompt REAL vs ANIME. null = batch cũ trước khi có trường này,
  // hoặc không tạo qua Trợ lý AI. Dùng lại ở lib/generations/regenerate-fresh.ts
  // để "Sửa lại" 1 ảnh sinh đúng phong cách gốc của batch.
  mediumId String?

  // Metadata Etsy (title/description/13 tags) cho CẢ bộ lịch này, do Trợ lý AI
  // sinh kèm lúc /api/generations/suggest -- xem lib/llm/finalize-suggestion.ts
  // ::finalizeEtsy. etsyTagsJson lưu mảng string dạng JSON. null = batch cũ
  // trước khi có tính năng này, hoặc tạo không qua Trợ lý AI.
  etsyTitle       String?
  etsyDescription String?
  etsyTagsJson    String?

  // SKU gốc (CAL-{MED}-{YYMM}-{CODE}) cố định cho bộ lịch khi đẩy R2 lần đầu.
  r2SkuBase  String?   @unique
  // Thư mục lưu trên R2 ({YYYY}/{sku-lower}_{title-slug}) tính ở lần đẩy đầu.
  r2Folder   String?
  // Trạng thái đẩy lên Cloudflare R2: "done" | "failed" | null.
  r2Status   String?
  // Thời điểm đẩy lên Cloudflare R2 thành công gần nhất.
  r2PushedAt DateTime?
  // Thông tin lỗi gần nhất nếu đẩy lên R2 thất bại.
  r2Error    String?

  jobs GenerationJob[]

  @@index([createdAt])
  @@index([status])
}

model GenerationJob {
  id                    String    @id @default(cuid())
  batchId               String
  indexInBatch          Int
  styleId               String?
  styleNameSnapshot     String?
  stylePositiveSnapshot String?
  styleNegativeSnapshot String?
  sceneId               String?
  sceneNameSnapshot     String?
  scenePositiveSnapshot String?
  sceneNegativeSnapshot String?
  poseId                String?
  poseNameSnapshot      String?
  posePositiveSnapshot  String?
  poseNegativeSnapshot  String?
  ideaPromptSnapshot    String
  positiveFinal         String
  negativeFinal         String
  overlaySpecJson       String?
  promptId              String?
  status                JobStatus @default(queued)
  seed                  BigInt?
  width                 Int?
  height                Int?
  steps                 Int?
  cfg                   Float?
  sampler               String?
  scheduler             String?
  errorCode             String?
  errorMessage          String?
  submittedAt           DateTime?
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  batch  GenerationBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  style  StylePreset?     @relation(fields: [styleId], references: [id], onDelete: SetNull)
  scene  ScenePreset?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  pose   PosePreset?      @relation(fields: [poseId], references: [id], onDelete: SetNull)
  images GeneratedImage[]

  @@index([batchId])
  @@index([status])
  @@index([styleId])
  @@index([sceneId])
  @@index([poseId])
  @@index([promptId])
}

model GeneratedImage {
  id                 String   @id @default(cuid())
  jobId              String
  relativePath       String
  filename           String
  mimeType           String
  width              Int?
  height             Int?
  // Vùng nhạy cảm (NudeNet, chạy local qua lib/censor/run-censor.ts). null =
  // chưa che (job cũ trước khi có tính năng này, hoặc đang chờ xử lý).
  maskedRelativePath String?
  // "censored" | "clean" | "failed" | "skipped" | null.
  maskStatus         String?
  // Bản phóng to để in lịch (upscale cục bộ, lib/images/upscale.ts). Bản gốc
  // nằm trong *_upscaled, bản đã che nằm trong *_upscaled_censored. null = chưa
  // upscale.
  upscaledRelativePath       String?
  upscaledMaskedRelativePath String?
  // "done" | "failed" | null.
  upscaleStatus              String?
  upscaledWidth              Int?
  upscaledHeight             Int?
  // id khổ template lịch đã upscale theo, vd "premade_wall_11x8_5".
  upscaleFormat              String?
  createdAt          DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
}
